# Backend OpenAI Compatible adapter configuration
# Do not commit real keys.
# If these values are missing, OPENAI_COMPATIBLE will show DISABLED or MISCONFIGURED.
# When unavailable, demo execution falls back to MOCK.
# This adapter is a generic OpenAI-compatible model entry and does not mean Codex / Claude Code / OpenCode are fully integrated.
AGENTHUB_OPENAI_BASE_URL=
AGENTHUB_OPENAI_API_KEY=
AGENTHUB_OPENAI_MODEL=

# CLI Agent Adapter configuration
# Do not commit real keys or sensitive local paths.
# Disabled adapters show DISABLED. Enabled adapters with missing command or args-template show MISCONFIGURED.
# If unavailable or failed, AgentHub falls back to MOCK.
# args-template supports: {prompt}, {taskDescription}, {userInput}
# These CLI adapters are probing/non-stream integrations and do not mean full Codex / Claude Code / OpenCode platform integration is complete.
AGENTHUB_CODEX_ENABLED=false
AGENTHUB_CODEX_COMMAND=codex
AGENTHUB_CODEX_ARGS_TEMPLATE=

AGENTHUB_CLAUDE_CODE_ENABLED=false
AGENTHUB_CLAUDE_CODE_COMMAND=claude
AGENTHUB_CLAUDE_CODE_ARGS_TEMPLATE=

AGENTHUB_OPEN_CODE_ENABLED=false
AGENTHUB_OPEN_CODE_COMMAND=opencode
AGENTHUB_OPEN_CODE_ARGS_TEMPLATE=
