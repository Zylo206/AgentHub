# Backend OpenAI Compatible adapter configuration
# Do not commit real keys.
# If these values are missing, OPENAI_COMPATIBLE will show DISABLED or MISCONFIGURED.
# When unavailable, demo execution falls back to MOCK.
# This adapter is a generic OpenAI-compatible model entry and does not mean Codex / Claude Code / OpenCode are fully integrated.
AGENTHUB_OPENAI_ENABLED=false
AGENTHUB_OPENAI_BASE_URL=
AGENTHUB_OPENAI_API_KEY=
AGENTHUB_OPENAI_MODEL=
# Set true when backend OpenAI-compatible adapter stream chunks are enabled.
AGENTHUB_OPENAI_STREAMING_ENABLED=false
AGENTHUB_OPENAI_JSON_RESPONSE_FORMAT_ENABLED=false
AGENTHUB_OPENAI_MAX_RETRIES=1
AGENTHUB_OPENAI_RETRY_BACKOFF_MILLIS=500

# Optional local verification flags for scripts/real-adapter-smoke-test.mjs.
# These are not backend runtime requirements and should only be enabled explicitly.
AGENTHUB_REAL_ADAPTER_SMOKE_EXPECT_CODE_BUILD=false

# DeepSeek OpenAI-compatible example. Do not commit real keys.
# AGENTHUB_OPENAI_ENABLED=true
# AGENTHUB_OPENAI_BASE_URL=https://api.deepseek.com
# AGENTHUB_OPENAI_MODEL=deepseek-v4-flash

# Optional Orchestrator planner mode.
# RULE_BASED is the stable default. LLM requires OPENAI_COMPATIBLE to be enabled and configured.
# If LLM planning fails and fallback is true, AgentHub returns to the rule-based planner.
AGENTHUB_PLANNER_TYPE=RULE_BASED
AGENTHUB_PLANNER_FALLBACK_TO_RULE_BASED=true

# Artifact generation mode:
# STATIC_TEMPLATE keeps deterministic demo artifacts only.
# HYBRID_REAL persists successful non-MOCK adapter output as additional artifacts while keeping static templates.
# REAL_FIRST is the forward path for preferring real adapter artifacts when stable.
AGENTHUB_ARTIFACT_GENERATION_MODE=HYBRID_REAL
AGENTHUB_ORCHESTRATOR_STEP_DELAY_MILLIS=0

# Message-level Orchestrator auto trigger.
# Product default: enabled with approval. Matched messages create a pending ApprovalRequest first; they do not auto-run.
# Modes: ALWAYS, KEYWORD, MENTION, KEYWORD_OR_MENTION.
AGENTHUB_ORCHESTRATOR_AUTO_TRIGGER_ENABLED=true
AGENTHUB_ORCHESTRATOR_AUTO_TRIGGER_REQUIRE_APPROVAL=true
AGENTHUB_ORCHESTRATOR_AUTO_TRIGGER_MODE=KEYWORD_OR_MENTION
AGENTHUB_ORCHESTRATOR_AUTO_TRIGGER_KEYWORDS=生成,创建,实现,修改,检查,review,页面,组件,workflow,工作流,协作,agent

# Reviewer decision gate.
# Default keeps demo tasks approved. Enable force rejection only for optional rejection/retry smoke or manual demos.
AGENTHUB_REVIEW_FORCE_REJECTION_ENABLED=false
AGENTHUB_REVIEW_REJECTION_KEYWORDS=REJECTION,decision: reject,reject,不通过,拒绝,blocker,阻塞

# Local file-backed Adapter routing stats persistence.
# Used by weighted routing. The default path is ignored by Git and safe for local demo snapshots.
AGENTHUB_ADAPTER_STATS_PERSISTENCE_ENABLED=true
AGENTHUB_ADAPTER_STATS_PERSISTENCE_PATH=./.agenthub/adapter-route-stats.json
AGENTHUB_ADAPTER_QUALITY_PERSISTENCE_ENABLED=true
AGENTHUB_ADAPTER_QUALITY_PERSISTENCE_PATH=./.agenthub/adapter-quality-metrics.json

# Persistence profile. Keep memory as the default local/demo-safe runtime.
# Set these from the shell for JDBC/MySQL verification; do not commit real passwords.
AGENTHUB_PERSISTENCE_MODE=memory
AGENTHUB_JDBC_URL=
AGENTHUB_JDBC_USERNAME=
AGENTHUB_JDBC_PASSWORD=

# Local frontend origins allowed by backend CORS.
AGENTHUB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local file-backed MemoryItem persistence for the MVP memory system.
# The default path is ignored by Git and is not a database replacement.
AGENTHUB_MEMORY_PERSISTENCE_ENABLED=true
AGENTHUB_MEMORY_PERSISTENCE_PATH=./.agenthub/memories.json
AGENTHUB_MEMORY_RETRIEVAL_LIMIT=6

# Context retrieval uses DB-backed Agentic Search by default:
# list candidates, grep exact keywords, then read authoritative source snippets.
# Embedding remains optional and disabled/fallback in this build.
AGENTHUB_CONTEXT_RETRIEVAL_LIMIT=8
AGENTHUB_CONTEXT_SEARCH_FULLTEXT_ENABLED=false
AGENTHUB_CONTEXT_SEARCH_MESSAGE_WINDOW=50
AGENTHUB_CONTEXT_SEARCH_ARTIFACT_WINDOW=50
AGENTHUB_CONTEXT_SEARCH_ATTACHMENT_WINDOW=30
AGENTHUB_CONTEXT_SEARCH_TASK_RUN_WINDOW=20
AGENTHUB_CONTEXT_SEARCH_GREP_LIMIT=20
AGENTHUB_CONTEXT_SEARCH_READ_MAX_CHARS=4000
AGENTHUB_CONTEXT_SEMANTIC_BACKEND=heuristic
AGENTHUB_CONTEXT_EMBEDDING_PROVIDER=disabled

# CLI Agent Adapter configuration
# Do not commit real keys or sensitive local paths.
# Disabled adapters show DISABLED. Enabled adapters with missing required command/config show MISCONFIGURED.
# If unavailable or failed, AgentHub falls back to MOCK.
# OpenCode args-template supports: {prompt}, {taskDescription}, {userInput}
# Codex production v1 should run Artifact-only and validate the AgentHub Artifact JSON contract.
# OpenCode remains a probing CLI integration.
# Claude Code uses a dedicated Artifact-only headless adapter when enabled.
# None of these adapters should commit real keys, login state, or sensitive local paths.
AGENTHUB_CODEX_ENABLED=false
AGENTHUB_CODEX_COMMAND=codex
AGENTHUB_CODEX_MODEL=
AGENTHUB_CODEX_TIMEOUT_SECONDS=120
AGENTHUB_CODEX_STREAMING_ENABLED=false
AGENTHUB_CODEX_ARTIFACT_ONLY=true
AGENTHUB_CODEX_WORK_DIR=.agenthub/codex-runs
AGENTHUB_CODEX_FIXTURE_ENABLED=false
AGENTHUB_CODEX_SMOKE_EXPECT_STREAMING=false

AGENTHUB_CLAUDE_CODE_ENABLED=false
AGENTHUB_CLAUDE_CODE_COMMAND=claude
AGENTHUB_CLAUDE_CODE_ARGS_TEMPLATE=
AGENTHUB_CLAUDE_CODE_MODEL=sonnet
AGENTHUB_CLAUDE_CODE_MAX_TURNS=3
AGENTHUB_CLAUDE_CODE_TIMEOUT_SECONDS=120
AGENTHUB_CLAUDE_CODE_STREAMING_ENABLED=false
AGENTHUB_CLAUDE_CODE_ARTIFACT_ONLY=true
AGENTHUB_CLAUDE_CODE_ALLOWED_TOOLS=Read,Grep,Glob
AGENTHUB_CLAUDE_CODE_DISALLOWED_TOOLS=Edit,MultiEdit,Write,NotebookEdit,Bash
AGENTHUB_CLAUDE_CODE_WORK_DIR=.agenthub/claude-code-runs
AGENTHUB_CLAUDE_CODE_FIXTURE_ENABLED=false
AGENTHUB_CLAUDE_CODE_SMOKE_EXPECT_STREAMING=false

AGENTHUB_OPEN_CODE_ENABLED=false
AGENTHUB_OPEN_CODE_COMMAND=opencode
AGENTHUB_OPEN_CODE_ARGS_TEMPLATE=
